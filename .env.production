# Valores de build de produção. Em hospedagem (Vercel), cadastre as variáveis
# no painel do projeto: elas têm prioridade sobre este arquivo.
# Nunca coloque segredos aqui (tudo que começa com VITE_ vai para o navegador).

# Validação completa de CPF/RG.
VITE_DEV_MODE=false

# Endereço da API (obrigatório no painel), ex.: https://smartsecretaria-api.onrender.com/api
# VITE_API_BASE_URL=

# Tempo limite das requisições (ms): folga para o servidor gratuito "acordar".
VITE_API_TIMEOUT=70000

# Demonstração pública: VITE_DEMO_MODE=true e VITE_DEMO_PASSWORD (a mesma
# DEMO_PASSWORD do backend) no painel da Vercel.

VITE_APP_NAME=SmartSecretaria
VITE_APP_VERSION=1.0.0
